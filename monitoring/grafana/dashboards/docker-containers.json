        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(container_memory_working_set_bytes{host=~\"$host\"}, name)",
          "refId": "VariableQuery"
        },
        "definition": "label_values(container_memory_working_set_bytes{host=~\"$host\"}, name)",
