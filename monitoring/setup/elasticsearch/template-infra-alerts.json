{
  "_meta": { "description": "Log lines that matched a Logstash alert rule" },
  "index_patterns": ["infra-alerts-*"],
  "priority": 200,
  "composed_of": ["infra-mappings"],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 1,
      "index.lifecycle.name": "infra-alerts-90d",
      "index.lifecycle.parse_origination_date": true
    }
  }
}
