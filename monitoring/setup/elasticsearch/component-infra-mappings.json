{
  "_meta": { "description": "Field types shared by all infra-* log indices" },
  "template": {
    "mappings": {
      "dynamic_templates": [
        {
          "strings_as_keyword": {
            "match_mapping_type": "string",
            "mapping": { "type": "keyword", "ignore_above": 1024 }
          }
        }
      ],
      "properties": {
        "@timestamp": { "type": "date" },
        "message": { "type": "text" },
        "log_message": { "type": "text" },
        "event": {
          "properties": {
            "original": { "type": "keyword", "index": false, "doc_values": false }
          }
        },
        "host": { "properties": { "name": { "type": "keyword" } } },
        "container": { "properties": { "name": { "type": "keyword" } } },
        "process": {
          "properties": {
            "name": { "type": "keyword" },
            "pid": { "type": "integer" }
          }
        },
        "log": { "properties": { "level": { "type": "keyword" } } },
        "app": {
          "properties": {
            "level": { "type": "keyword" },
            "method": { "type": "keyword" },
            "path": { "type": "keyword" },
            "status": { "type": "integer" },
            "durationMs": { "type": "integer" }
          }
        },
        "alert": {
          "properties": {
            "rule": { "type": "keyword" },
            "severity": { "type": "keyword" }
          }
        }
      }
    }
  }
}
