{
  "policy": {
    "_meta": { "description": "Alert history is small and useful for post-mortems: keep 90 days" },
    "phases": {
      "hot": {
        "min_age": "0ms",
        "actions": { "set_priority": { "priority": 100 } }
      },
      "delete": {
        "min_age": "90d",
        "actions": { "delete": {} }
      }
    }
  }
}
