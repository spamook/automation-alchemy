{
  "policy": {
    "_meta": { "description": "Daily log indices: searchable for 30 days, then deleted" },
    "phases": {
      "hot": {
        "min_age": "0ms",
        "actions": { "set_priority": { "priority": 100 } }
      },
      "delete": {
        "min_age": "30d",
        "actions": { "delete": {} }
      }
    }
  }
}
